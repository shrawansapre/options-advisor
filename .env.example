# Copy this to .env and fill in your values.
# All variables are optional — the app degrades gracefully without each one.

# ── Anthropic (local dev only) ─────────────────────────────────────────────────
# Enables direct browser → Anthropic calls in local dev.
# Leave this UNSET in Vercel — its absence activates the /api/analyze proxy.
VITE_ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Anthropic (server-side / Vercel) ──────────────────────────────────────────
# Set this in your Vercel project dashboard, not here.
# Used by api/analyze.js — never reaches the browser.
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Market Data (live options chain + Greeks) ─────────────────────────────────
# Get your token from marketdata.app → account → API token.
# Without this, market data is unavailable and the app falls back to web search.
# Set in .env.local for local dev (requires vercel dev), and in Vercel dashboard for prod.
MARKET_DATA_TOKEN=your-token-here

# ── Supabase (auth + history sync) ────────────────────────────────────────────
# Get these from your Supabase project → Settings → API.
# Without these, auth is disabled and history stays in localStorage only.
VITE_SUPABASE_URL=https://yourproject.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
